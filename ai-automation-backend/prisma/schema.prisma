generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  password      String
  role          Role     @default(USER)
  isActive      Boolean  @default(true)
  credits       Int      @default(100)
  refreshToken  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  images        GeneratedImage[]
  videos        GeneratedVideo[]
  prompts       PromptHistory[]
  favorites     Favorite[]
  credits_tx    CreditTransaction[]
  notifications Notification[]
  apiKeys       APIKey[]
  auditLogs     AuditLog[]
  workspaces    WorkspaceMember[]
  socialAccounts SocialAccount[]
  scheduledPosts ScheduledPost[]
  projects      Project[]
  uploadedAssets UploadedAsset[]
  
  @@map("users")
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

model Workspace {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  plan        Plan     @default(FREE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  members     WorkspaceMember[]
  @@map("workspaces")
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  role        String    @default("member")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  @@unique([userId, workspaceId])
  @@map("workspace_members")
}

model AIModel {
  id                    String   @id @default(cuid())
  provider              String
  name                  String
  displayName           String
  category              ModelCategory
  version               String?
  isActive              Boolean  @default(true)
  isFree                Boolean  @default(false)
  pricingType           String   @default("PAID")
  creditsPerGeneration  Int      @default(5)
  pricePerGeneration    Float    @default(5)
  supportsTextToImage   Boolean  @default(false)
  supportsImageToImage  Boolean  @default(false)
  supportsTextToVideo   Boolean  @default(false)
  supportsImageToVideo  Boolean  @default(false)
  maxResolution         String?
  maxDuration           Int?
  supportsNegativePrompt Boolean @default(false)
  supportsSeed          Boolean  @default(false)
  supportsStreaming      Boolean  @default(false)
  defaultParams         Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  images                GeneratedImage[]
  videos                GeneratedVideo[]
  @@unique([provider, name])
  @@map("ai_models")
}

enum ModelCategory {
  IMAGE
  VIDEO
  TEXT
  AUDIO
}

model GenerationJob {
  id           String    @id @default(cuid())
  userId       String
  type         JobType
  status       JobStatus @default(PENDING)
  provider     String
  model        String
  prompt       String
  params       Json?
  result       Json?
  errorMessage String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  workflowSteps WorkflowStep[]
  @@map("generation_jobs")
}

enum JobType {
  IMAGE
  VIDEO
  CAPTION
  HASHTAG
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  RETRYING
}

model WorkflowStep {
  id         String    @id @default(cuid())
  jobId      String
  stepName   String
  status     JobStatus @default(PENDING)
  input      Json?
  output     Json?
  errorMsg   String?
  durationMs Int?
  createdAt  DateTime  @default(now())
  job        GenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  @@map("workflow_steps")
}

model GeneratedImage {
  id           String   @id @default(cuid())
  userId       String
  modelId      String?
  promptId     String?
  projectId    String?
  provider     String
  model        String
  prompt       String
  negPrompt    String?
  style        String?
  ratio        String?
  width        Int?
  height       Int?
  cloudinaryId String?
  url          String
  thumbnailUrl String?
  fileSize     Int?
  isFavorite   Boolean  @default(false)
  creditsUsed  Int      @default(5)
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiModel      AIModel? @relation(fields: [modelId], references: [id])
  project      Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  favorites    Favorite[]
  @@index([userId, projectId])
  @@map("generated_images")
}

model GeneratedVideo {
  id           String   @id @default(cuid())
  userId       String
  modelId      String?
  promptId     String?
  provider     String
  model        String
  prompt       String
  style        String?
  duration     Int?
  resolution   String?
  fps          Int?
  cloudinaryId String?
  url          String?
  thumbnailUrl String?
  fileSize     Int?
  isFavorite   Boolean  @default(false)
  status       JobStatus @default(PENDING)
  jobId        String?
  creditsUsed  Int      @default(20)
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiModel      AIModel? @relation(fields: [modelId], references: [id])
  favorites    Favorite[]
  @@map("generated_videos")
}

model PromptHistory {
  id             String   @id @default(cuid())
  userId         String
  originalPrompt String
  enhancedPrompt String?
  provider       String?
  model          String?
  category       String?
  creditsUsed    Int?
  generationMs   Int?
  status         String?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("prompt_history")
}

model Favorite {
  id       String  @id @default(cuid())
  userId   String
  imageId  String?
  videoId  String?
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  image    GeneratedImage? @relation(fields: [imageId], references: [id], onDelete: Cascade)
  video    GeneratedVideo? @relation(fields: [videoId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([userId, imageId])
  @@unique([userId, videoId])
  @@map("favorites")
}

model CreditTransaction {
  id          String   @id @default(cuid())
  userId      String
  amount      Int
  type        String
  description String?
  balanceAfter Int
  metadata    Json?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("credit_transactions")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  data      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("notifications")
}

model APIKey {
  id          String   @id @default(cuid())
  userId      String
  name        String
  key         String   @unique
  lastUsedAt  DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("api_keys")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  resource  String?
  resourceId String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
  @@map("audit_logs")
}

model UsageLog {
  id           String   @id @default(cuid())
  userId       String
  provider     String
  model        String
  jobType      String
  latencyMs    Int?
  success      Boolean
  errorCode    String?
  creditsUsed  Int      @default(0)
  cost         Float    @default(0)
  createdAt    DateTime @default(now())
  @@map("usage_logs")
}

model SocialAccount {
  id                  String   @id @default(cuid())
  userId              String
  platform            String   // 'instagram', 'facebook', etc.
  platformUserId      String   // ID from the platform
  pageId              String?  // Optional page ID if linked to a FB page
  username            String
  accessTokenEncrypted String
  tokenExpiresAt      DateTime?
  status              String   @default("CONNECTED") // 'CONNECTED', 'DISCONNECTED', 'EXPIRED'
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduledPosts      ScheduledPost[]

  @@unique([platform, platformUserId])
  @@map("social_accounts")
}

model ScheduledPost {
  id              String   @id @default(cuid())
  userId          String
  socialAccountId String
  platform        String
  mediaUrl        String
  uploadedAssetId String?
  caption         String?  @db.Text
  scheduledAtUTC  DateTime?
  status          String   @default("SCHEDULED") // SCHEDULED, PROCESSING, PUBLISHED, FAILED, CANCELLED
  publishedAt     DateTime?
  externalPostId  String?
  errorMessage    String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  uploadedAsset   UploadedAsset? @relation(fields: [uploadedAssetId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([scheduledAtUTC, status])
  @@index([uploadedAssetId])
  @@map("scheduled_posts")
}

model Project {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?  @db.Text
  status      String   @default("active") // 'active', 'archived', 'completed'
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  images         GeneratedImage[]
  uploadedAssets UploadedAsset[]

  @@index([userId, status])
  @@map("projects")
}

model UploadedAsset {
  id                 String          @id @default(cuid())
  userId             String
  fileName           String
  originalName       String
  mimeType           String
  resourceType       String          @default("image") // "image" | "video"
  url                String
  secureUrl          String
  cloudinaryPublicId String?
  format             String?
  width              Int?
  height             Int?
  duration           Float?
  fileSize           Int?
  source             String          @default("UPLOAD")
  projectId          String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  project            Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  scheduledPosts     ScheduledPost[]

  @@index([userId, resourceType])
  @@index([userId, projectId])
  @@map("uploaded_assets")
}

