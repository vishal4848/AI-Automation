NODE_ENV=development
PORT=3001

# PostgreSQL Database (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_automation"

# Redis & BullMQ Queues
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=your-32-char-jwt-secret-key-here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-32-char-jwt-refresh-secret-here
JWT_REFRESH_EXPIRES_IN=30d

# Token Encryption (AES-256-GCM)
TOKEN_ENCRYPTION_KEY=your-32-character-encryption-key

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Cloudinary Storage (optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI Provider API Keys
HUGGINGFACE_API_TOKEN=
HF_TOKEN=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
GEMINI_API_KEY=
REPLICATE_API_TOKEN=
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-schnell
REPLICATE_VIDEO_MODEL=wan-video/wan-2.1-t2v-480p
FAL_KEY=

# Meta & Instagram Graph API Configuration
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
META_REDIRECT_URI=http://localhost:3001/api/v1/social/instagram/callback
META_FACEBOOK_REDIRECT_URI=http://localhost:3001/api/v1/social/facebook/callback
META_API_VERSION=v20.0
INSTAGRAM_AUTH_FLOW=facebook

# LinkedIn OAuth 2.0 Configuration
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3001/api/v1/social/linkedin/callback
LINKEDIN_API_VERSION=202601
LINKEDIN_SCOPES="openid profile email w_member_social w_organization_social"
